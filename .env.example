# Code Signing Configuration
# This file shows all available environment variables for code signing.
# Copy this to .env.local (git-ignored) and fill in your values.

# ═══════════════════════════════════════════════════════════════════
# WINDOWS CODE SIGNING
# ═══════════════════════════════════════════════════════════════════

# Path to your Windows code signing certificate (PFX file)
# Download from a certificate authority like DigiCert, Sectigo, etc.
# Example: C:\path\to\cert.pfx
WINDOWS_CERTIFICATE_FILE=

# Password for your PFX certificate
WINDOWS_CERTIFICATE_PASSWORD=

# Timestamp server URL (optional, but recommended)
# This ensures your signature remains valid even after your cert expires
# Common options:
#   - http://timestamp.digicert.com (DigiCert)
#   - http://timestamp.sectigo.com (Sectigo)
#   - http://timestamp.globalsign.com (GlobalSign)
WINDOWS_TIMESTAMP_SERVER=http://timestamp.digicert.com


